root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.bash]
shell_variant = bash
switch_case_indent = true
binary_next_line = true

[{bin/*,.githooks/*}]
shell_variant = bash
switch_case_indent = true
binary_next_line = true
